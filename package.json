{
  "name": "@openclaw-vk/vk",
  "version": "2026.9.2",
  "description": "OpenClaw VK (VKontakte) channel plugin",
  "author": {
    "name": "Pavel Frankov",
    "url": "https://github.com/pfrankov"
  },
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.22.3"
  },
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "openclaw-channel",
    "vk",
    "vkontakte",
    "vk-bot",
    "bot"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pfrankov/openclaw-vk.git"
  },
  "bugs": {
    "url": "https://github.com/pfrankov/openclaw-vk/issues"
  },
  "homepage": "https://github.com/pfrankov/openclaw-vk#readme",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "api.ts",
    "index.ts",
    "setup-entry.ts",
    "openclaw.plugin.json",
    "src/accounts.ts",
    "src/audio-chunk.ts",
    "src/channel.setup.ts",
    "src/channel.ts",
    "src/config-schema.ts",
    "src/diagnostics.ts",
    "src/vk-errors.ts",
    "src/format.ts",
    "src/inbound.ts",
    "src/keyboard.ts",
    "src/media.ts",
    "src/monitor.ts",
    "src/probe.ts",
    "src/progress-draft.ts",
    "src/reactions-controller.ts",
    "src/runtime.ts",
    "src/sanitize.ts",
    "src/sdk-compat.ts",
    "src/send-support.ts",
    "src/send.ts",
    "src/setup-core.ts",
    "src/setup-surface.ts",
    "src/stall-watchdog.ts",
    "src/tts-parts.ts",
    "src/types.ts"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "npm run check:sdk-imports && npm run test:coverage && npm run build && npm run check:pack",
    "check:pack": "npm pack --dry-run",
    "check:runtime": "node scripts/smoke-runtime.mjs",
    "check:sdk-imports": "node scripts/check-sdk-imports.mjs",
    "prepack": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check:types": "node scripts/check-types.mjs"
  },
  "dependencies": {
    "markdown-to-vk": "^0.3.2",
    "vk-io": "^4.10.1",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "openclaw": ">=2026.8.1-0"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "bundleDependencies": [
    "vk-io"
  ],
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@vitest/coverage-v8": "^3.2.7",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "openclaw": {
    "compat": {
      "pluginApi": ">=2026.8.1-0",
      "minGatewayVersion": "2026.8.1"
    },
    "build": {
      "openclawVersion": "2026.8.1",
      "pluginSdkVersion": "2026.8.1"
    },
    "extensions": [
      "./index.ts"
    ],
    "runtimeExtensions": [
      "./dist/index.js"
    ],
    "setupEntry": "./setup-entry.ts",
    "runtimeSetupEntry": "./dist/setup-entry.js",
    "channel": {
      "id": "vk",
      "label": "VK",
      "selectionLabel": "VK (VKontakte Bot)",
      "docsPath": "/channels/vk",
      "docsLabel": "vk",
      "blurb": "VK (VKontakte) community bot via Long Poll API.",
      "order": 80,
      "quickstartAllowFrom": true
    },
    "install": {
      "npmSpec": "@openclaw-vk/vk",
      "localPath": "extensions/vk",
      "defaultChoice": "npm"
    }
  }
}
