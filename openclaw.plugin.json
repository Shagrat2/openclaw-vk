{
  "id": "vk",
  "channels": [
    "vk"
  ],
  "doctorContract": {
    "stateMigrations": []
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {}
  },
  "channelConfigs": {
    "vk": {
      "label": "VK",
      "description": "VK (VKontakte) community bot via Long Poll API.",
      "schema": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "token": {
            "description": "Community access token, or a SecretRef { source, provider, id } the gateway resolves at startup.",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "source": {
                        "type": "string",
                        "const": "env"
                      },
                      "provider": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9_-]{0,63}$"
                      },
                      "id": {
                        "type": "string",
                        "pattern": "^[A-Z][A-Z0-9_]{0,127}$"
                      }
                    },
                    "required": [
                      "source",
                      "provider",
                      "id"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "source": {
                        "type": "string",
                        "const": "store"
                      },
                      "provider": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9_-]{0,63}$"
                      },
                      "id": {
                        "type": "string",
                        "pattern": "^[A-Z][A-Z0-9_]{0,127}$"
                      }
                    },
                    "required": [
                      "source",
                      "provider",
                      "id"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "source": {
                        "type": "string",
                        "const": "file"
                      },
                      "provider": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9_-]{0,63}$"
                      },
                      "id": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "source",
                      "provider",
                      "id"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "source": {
                        "type": "string",
                        "const": "exec"
                      },
                      "provider": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9_-]{0,63}$"
                      },
                      "id": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "source",
                      "provider",
                      "id"
                    ],
                    "additionalProperties": false
                  }
                ]
              }
            ]
          },
          "diagnostics": {
            "type": "object",
            "description": "Channel-wide diagnostics level. `openclaw config validate` reads this schema, so the level is typed here as well as in the zod schema.",
            "additionalProperties": false,
            "properties": {
              "level": {
                "type": "string",
                "enum": [
                  "off",
                  "redacted",
                  "full"
                ]
              }
            }
          },
          "contextVisibility": {
            "type": "string",
            "description": "Which shared context reaches the agent in groups: every forward and quote (`all`), only those from allowlisted authors (`allowlist`), or the same plus a quote of the bot's own message (`allowlist_quote`). Accepted per account too.",
            "enum": [
              "all",
              "allowlist",
              "allowlist_quote"
            ]
          },
          "audio": {
            "type": "object",
            "description": "Channel-wide voice limits; `settings.ts` reads `channels.vk.audio` for every account, so they are not accepted per account. `openclaw config validate` reads this schema, so the limits are typed here as well as in the zod schema.",
            "additionalProperties": false,
            "properties": {
              "maxVoiceMs": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "description": "Hard cap for one voice message; VK rejects longer ones."
              },
              "splitDeadlineMs": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "description": "Deadline for the whole split operation."
              },
              "splitTimeoutMs": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "description": "Timeout for a single ffmpeg/ffprobe run."
              },
              "maxInputBytes": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "description": "Input files larger than this are not split at all."
              },
              "maxSegments": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "description": "Ceiling on segments: nobody listens to more voice messages than this."
              },
              "remoteMaxBytes": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "description": "Download ceiling for remote media; the URL comes from a model reply."
              }
            }
          },
          "accounts": {
            "type": "object",
            "description": "Per-account overrides. Diagnostics and voice limits are channel-wide; contextVisibility can be overridden here.",
            "additionalProperties": {
              "type": "object",
              "allOf": [
                {
                  "not": {
                    "required": [
                      "diagnostics"
                    ]
                  }
                },
                {
                  "not": {
                    "required": [
                      "audio"
                    ]
                  }
                }
              ],
              "properties": {
                "token": {
                  "description": "Community access token, or a SecretRef { source, provider, id } the gateway resolves at startup.",
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "oneOf": [
                        {
                          "type": "object",
                          "properties": {
                            "source": {
                              "type": "string",
                              "const": "env"
                            },
                            "provider": {
                              "type": "string",
                              "pattern": "^[a-z][a-z0-9_-]{0,63}$"
                            },
                            "id": {
                              "type": "string",
                              "pattern": "^[A-Z][A-Z0-9_]{0,127}$"
                            }
                          },
                          "required": [
                            "source",
                            "provider",
                            "id"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "source": {
                              "type": "string",
                              "const": "store"
                            },
                            "provider": {
                              "type": "string",
                              "pattern": "^[a-z][a-z0-9_-]{0,63}$"
                            },
                            "id": {
                              "type": "string",
                              "pattern": "^[A-Z][A-Z0-9_]{0,127}$"
                            }
                          },
                          "required": [
                            "source",
                            "provider",
                            "id"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "source": {
                              "type": "string",
                              "const": "file"
                            },
                            "provider": {
                              "type": "string",
                              "pattern": "^[a-z][a-z0-9_-]{0,63}$"
                            },
                            "id": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "source",
                            "provider",
                            "id"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "source": {
                              "type": "string",
                              "const": "exec"
                            },
                            "provider": {
                              "type": "string",
                              "pattern": "^[a-z][a-z0-9_-]{0,63}$"
                            },
                            "id": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "source",
                            "provider",
                            "id"
                          ],
                          "additionalProperties": false
                        }
                      ]
                    }
                  ]
                },
                "contextVisibility": {
                  "type": "string",
                  "description": "Overrides the channel-wide contextVisibility for this account.",
                  "enum": [
                    "all",
                    "allowlist",
                    "allowlist_quote"
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
